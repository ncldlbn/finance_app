# Copia questo file in .env (che NON va in git) e cambia i valori.

# Password del PROPRIETARIO del database (schema e migrazioni) e dell'utente con cui lavora l'app
# (senza privilegi, soggetto alla Row-Level Security). Solo lettere e cifre: finiscono in un indirizzo postgresql://.
POSTGRES_PASSWORD=cambiaQuestaPassword1
APP_DB_PASSWORD=cambiaAncheQuesta2
# Chiave che firma le sessioni: generala con  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Porta su 127.0.0.1 a cui risponde l'app (il proxy HTTPS la inoltra qui).
APP_PORT=8000
# 0 = niente registrazione pubblica (/registrati).
REGISTRATION_OPEN=1
# Solo per provare in locale senza HTTPS: 0 fa viaggiare il cookie di sessione anche su http (MAI in produzione).
COOKIE_SECURE=1

# Backup: ogni quanti secondi (86400 = un giorno) e quante copie tenere in ./backups.
BACKUP_EVERY=86400
BACKUP_KEEP=14

# Connessioni al database per ogni processo dell'app e tempo massimo di una query (millisecondi).
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000

# Email (verifica dell'indirizzo e recupero password): credenziali SMTP del servizio scelto e indirizzo pubblico
# https:// dell'app. Senza SMTP_HOST registrazione e recupero password restano spenti.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
MAIL_FROM=Finance Tracker <noreply@tuodominio.it>
APP_BASE_URL=https://tuodominio.it
# Sviluppo con Mailpit (docker compose --profile dev up): SMTP_HOST=mailpit, SMTP_PORT=1025, SMTP_SECURITY=none,
# APP_BASE_URL=http://127.0.0.1:8000 e COOKIE_SECURE=0. Le email si leggono su http://127.0.0.1:8025.

# Facoltativo, in alternativa a scripts/add_user.py: crea l'utente 1 con questa password al primo avvio.
# APP_PASSWORD_HASH='...'   (generalo con python scripts/set_password.py; TRA APICI SINGOLI: contiene il carattere $,
#                           che docker compose altrimenti interpreta e rovina)
# APP_USERNAME=admin
